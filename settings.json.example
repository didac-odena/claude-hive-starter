{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_HOME>/hive-bridge/bridge.py check --mode session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_HOME>/hooks/routing-check.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_HOME>/hive-bridge/bridge.py check --mode user-prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash <CLAUDE_HOME>/hooks/rtk-rewrite.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_HOME>/hooks/routing-check.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_HOME>/hive-bridge/bridge.py check --mode post-tool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_HOME>/hooks/hive-remind.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python <CLAUDE_HOME>/status.py"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  },
  "extraKnownMarketplaces": {
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    }
  },
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true
}
